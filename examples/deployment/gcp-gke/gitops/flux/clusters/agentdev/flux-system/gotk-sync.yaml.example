# Flux source and root sync (agentdev #385). Copy to gotk-sync.yaml and set the url of your deployment repository.
# The deploy workflow (.github/workflows/deploy.yml, job render) writes the branch `gitops`: the tree of `main` plus
# rendered/platform and rendered/agents. Flux reads only that branch. The Secret flux-system holds the read-only deploy
# key; it is made by `flux create secret git` (docs/admin.md, "Install an instance with Flux"), never in Git.
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 1m
  url: ssh://git@github.com/<owner>/<deployment-repository>
  ref: {branch: gitops}
  secretRef: {name: flux-system}
  ignore: |
    # only the GitOps tree and the rendered output, not terraform/ or ansible/
    /*
    !/gitops/flux/
    !/rendered/
---
# Root sync: the Flux controllers themselves (this directory) and the three layers (../layers.yaml)
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: 10m
  sourceRef: {kind: GitRepository, name: flux-system}
  path: ./gitops/flux/clusters/agentdev
  prune: true
  wait: false
