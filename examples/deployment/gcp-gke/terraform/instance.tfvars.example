# Copy to instance.tfvars and fill in. This file holds no secrets, so it can be committed in the
# (private) deployment repository.
project_id         = "my-agentdev"
region             = "europe-west4"
zone               = "europe-west4-a"
billing_account_id = "000000-000000-000000"
github_repository  = "my-org/my-agentdev-deploy"
budget_amount_usd  = 150     # in budget_currency
# budget_currency  = "EUR"   # the billing account currency; default USD
# create_budget    = false   # no budget, no billing IAM for CI (agentdev #199); the first apply with true needs billing.accounts.setIamPolicy
# public_hosts       = ["agentdev.example.com", "auth.example.com"]   # agentdev #120; DNS A record -> terraform output webhook_ip
# cloud_armor        = false
# create_artifact_registry = false   # agentdev #157: images come from GHCR
# system_disk_size_gb = 30              # agentdev #170: node boot disks; changing one replaces the node pool
# system_disk_type    = "pd-standard"   # default; "pd-balanced" keeps a pre-#170 pool unchanged
# agent_disk_size_gb  = 50
# agent_disk_type     = "pd-standard"
labels = { environment = "prod" }   # agentdev #184: dev, stage or prod; service = "agentdev" is added
# system_pool_spot = true   # agentdev #171: cheaper system pool, ~1 minute platform gap when a node is reclaimed
# Cluster add-ons (agentdev #208): lean by default (Managed Prometheus, Filestore CSI and the extra monitoring
# components are off; the load balancer is on only with public_hosts). Set one back to keep an older cluster as it was.
# enable_managed_prometheus = true
# enable_filestore_csi      = true
# monitoring_components     = null   # the GKE default list
# gateway_enabled           = true   # keep the load balancer without public_hosts
