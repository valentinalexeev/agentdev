{
 "__requires": [
  {
   "type": "datasource",
   "id": "prometheus",
   "name": "Prometheus",
   "version": "1.0.0"
  }
 ],
 "uid": "agentdev-llm-cost",
 "title": "agentdev: Claude cost and usage",
 "tags": [
  "agentdev",
  "llm"
 ],
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "editable": false,
 "description": "ADR 0002 (#196). Per-job cost is on GET /status and the web UI (Cost per job); the job id is never a metric label. Import into any Grafana: pick the Prometheus data source; the instance variable selects agentdev instances (label agentdev_instance).",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "instance",
    "label": "Instance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(agentdev_budget_used, agentdev_instance)",
     "refId": "A"
    },
    "definition": "label_values(agentdev_budget_used, agentdev_instance)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2,
    "sort": 1
   },
   {
    "name": "agent",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(agentdev_budget_used{agentdev_instance=~\"$instance\"}, agentdev_agent)",
     "refId": "A"
    },
    "definition": "label_values(agentdev_budget_used{agentdev_instance=~\"$instance\"}, agentdev_agent)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Cost units per agent (per hour)",
   "description": "Input-token equivalents of the reference model (ADR 0002 D2).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agentdev_agent) (increase(agentdev_cost_units_total{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[1h]))",
     "legendFormat": "{{agentdev_agent}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Cost units per model (per hour)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (gen_ai_response_model) (increase(agentdev_cost_units_total{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[1h]))",
     "legendFormat": "{{gen_ai_response_model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Budget used vs limit (24 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "agentdev_budget_used{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}",
     "legendFormat": "{{agentdev_agent}} used",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "agentdev_budget_limit{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"} > 0",
     "legendFormat": "{{agentdev_agent}} limit",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "bargauge",
   "title": "Budget used (% of limit)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {},
   "targets": [
    {
     "refId": "A",
     "expr": "100 * agentdev_budget_used{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"} / (agentdev_budget_limit{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"} > 0)",
     "legendFormat": "{{agentdev_agent}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Subscription utilization (5 h / 7 d)",
   "description": "From the anthropic-ratelimit-unified headers; the operator pauses agents at the thresholds (#93).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * agentdev_ratelimit_utilization{agentdev_instance=~\"$instance\"}",
     "legendFormat": "{{agentdev_subscription}} {{agentdev_window}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Paused agents",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "agentdev_usage_paused{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}",
     "legendFormat": "{{agentdev_agent}} {{agentdev_reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Cache-read share of input tokens",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agentdev_agent) (increase(gen_ai_client_token_usage_sum{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\",agentdev_cache=\"read\"}[1h])) / sum by (agentdev_agent) (increase(gen_ai_client_token_usage_sum{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\",gen_ai_token_type=\"input\"}[1h]))",
     "legendFormat": "{{agentdev_agent}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Tokens per type (per hour)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (gen_ai_token_type, agentdev_cache) (increase(gen_ai_client_token_usage_sum{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[1h]))",
     "legendFormat": "{{gen_ai_token_type}} {{agentdev_cache}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Estimated USD per agent (per day)",
   "description": "Only when claude-proxy-prices sets usd_per_million_units (owner decision 2). An estimate, not the bill.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agentdev_agent) (increase(agentdev_cost_usd_total{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[24h]))",
     "legendFormat": "{{agentdev_agent}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Refused requests",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agentdev_agent, agentdev_reason) (increase(agentdev_requests_refused_total{agentdev_instance=~\"$instance\"}[1h]))",
     "legendFormat": "{{agentdev_agent}} {{agentdev_reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Model request duration (p50 / p95)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[15m])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{agentdev_instance=~\"$instance\",agentdev_agent=~\"$agent\"}[15m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ]
  }
 ]
}
