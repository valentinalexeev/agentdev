# agentdev API (#46), namespace ${PLATFORM_NS}. Rendered by 10-api.sh. Reads agent state and writes Agent objects
# (#57 step 3; the API checks the caller's forge permission first); every /api call needs an authentik OIDC token for
# client ${OIDC_AUDIENCE}.
apiVersion: v1
kind: ServiceAccount
metadata: {name: agentdev-api, namespace: ${PLATFORM_NS}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-api-read, namespace: ${AGENTS_NS}}
rules:
- {apiGroups: [apps], resources: [statefulsets], verbs: [get, list, watch]}
- {apiGroups: [agentdev.dev], resources: [agents], verbs: [get, list, watch, patch, create, delete]}   # Agents only: no Secrets, no StatefulSets, no PVCs
- {apiGroups: [agentdev.dev], resources: [securityevents], verbs: [get, list, watch]}   # copied to Postgres (#70)
- {apiGroups: [agentdev.dev], resources: [approvals], verbs: [get, list, watch]}         # approvals (#67): read
- {apiGroups: [agentdev.dev], resources: [approvals/status], verbs: [update]}            # the decision, nothing else
- {apiGroups: [""], resources: [pods], verbs: [list]}                                    # void requests of gone agent pods (#67)
# usage limits (#93): thresholds (written by admins and project writers, audited) and the operator's usage state (read)
- {apiGroups: [""], resources: [configmaps], verbs: [create]}   # create cannot be narrowed by name; only agentdev-usage-settings is created
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-usage-settings], verbs: [get, update]}
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-usage], verbs: [get]}
# console chat sessions (#346): the API starts and ends chat-* Jobs and reads their pods' addresses. The Job shape is
# held by the ValidatingAdmissionPolicy agentdev-api-chat-jobs below (no Secrets other than the chat clone token and
# the agent's proxy key, gVisor, no service account token). Created even with chat off, so turning it on needs no RBAC change.
# delete cannot be narrowed by label in RBAC: the ValidatingAdmissionPolicy agentdev-api-chat-jobs-delete allows only chat-* console Jobs
- {apiGroups: [batch], resources: [jobs], verbs: [get, list, create, delete]}
- {apiGroups: [""], resources: [pods], verbs: [get]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-api-read, namespace: ${AGENTS_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-api-read}
subjects: [{kind: ServiceAccount, name: agentdev-api, namespace: ${PLATFORM_NS}}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: agentdev-api, namespace: ${PLATFORM_NS}, labels: {app: agentdev-api}}
spec:
  replicas: 1
  selector: {matchLabels: {app: agentdev-api}}
  template:
    metadata: {labels: {app: agentdev-api, agentdev/db-client: "true"}}   # may reach platform-db (#70)
    spec:
      serviceAccountName: agentdev-api
      # fsGroup: the API user (image USER 65532) reads the App key file (group read, mode 0440)
      securityContext: {runAsNonRoot: true, runAsUser: 65532, runAsGroup: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: api
        image: ${API_IMAGE}
        env:
        - {name: OIDC_ISSUER, value: "${OIDC_ISSUER}"}
        - {name: OIDC_DISCOVERY_URL, value: "${OIDC_DISCOVERY_URL}"}
        - {name: OIDC_AUDIENCE, value: "${OIDC_AUDIENCE}"}
        - {name: AGENTS_NS, value: "${AGENTS_NS}"}
        - {name: FORGE_URL, value: "${FORGE_URL}"}
        - {name: ADMIN_GROUP, value: agentdev-admins}
        - {name: APPROVALS, value: "${APPROVALS}"}   # #67: decide approval requests from forge comments
        # forge logins that never decide (router or App bot, the API's token user, other service accounts); agents are
        # excluded by account id anyway
        - {name: APPROVAL_DENY_ACCOUNTS, value: "${APPROVAL_DENY_ACCOUNTS}"}
        - {name: USAGE_FIVE_HOUR, value: "${USAGE_FIVE_HOUR}"}   # same defaults as the operator (#93), shown in the web UI
        - {name: USAGE_WEEKLY, value: "${USAGE_WEEKLY}"}
        # agent caps (#27) for POST /api/agents: all agents, and agents per person (admin group exempt); 0 = no cap
        - {name: MAX_AGENTS, value: "${MAX_AGENTS}"}
        - {name: MAX_AGENTS_PER_USER, value: "${MAX_AGENTS_PER_USER}"}
        # console chat sessions (#346, images/api/chat.go): Jobs in ${AGENTS_NS} that run the worker image's session
        # server. CHAT_TOKEN_KEY (Secret agentdev-api-chat) derives the per-session token for the session servers;
        # CHAT_ISSUE_TOKEN (same Secret, Gitea only) creates issues from drafts as the person (Sudo).
        - {name: CHAT_SESSIONS, value: "${CHAT_SESSIONS}"}
        - {name: CHAT_WORKER_IMAGE, value: "${CHAT_WORKER_IMAGE}"}
        - {name: CHAT_IMAGE_PULL_POLICY, value: "${CHAT_IMAGE_PULL_POLICY}"}
        - {name: CHAT_FORGE_URL, value: "${CHAT_FORGE_URL}"}
        - {name: CHAT_CLAUDE_PROXY_URL, value: "http://claude-proxy.${AGENTS_NS}.svc.cluster.local:8080"}
        - {name: CHAT_EGRESS_PROXY, value: "http://egress-proxy.${AGENTS_NS}.svc.cluster.local:3128"}
        - {name: CHAT_IDLE_SECONDS, value: "${CHAT_IDLE_SECONDS}"}
        - {name: CHAT_RETENTION_DAYS, value: "${CHAT_RETENTION_DAYS}"}
        - {name: CHAT_MAX_SESSIONS, value: "${CHAT_MAX_SESSIONS}"}
        - {name: CHAT_MAX_SESSIONS_PER_USER, value: "${CHAT_MAX_SESSIONS_PER_USER}"}
        - name: CHAT_TOKEN_KEY
          valueFrom: {secretKeyRef: {name: agentdev-api-chat, key: CHAT_TOKEN_KEY, optional: true}}
        - name: CHAT_ISSUE_TOKEN
          valueFrom: {secretKeyRef: {name: agentdev-api-chat, key: CHAT_ISSUE_TOKEN, optional: true}}
        # per-agent Claude budget for the UI (#66); the proxy's /status has no credentials. Absent proxy: no budget column
        - {name: CLAUDE_PROXY_STATUS_URL, value: "http://claude-proxy.${AGENTS_NS}.svc.cluster.local:8080/status"}
        # forge token for the live permission check of writes (read on the repositories only). Optional: without it
        # every write that needs the forge gives 503 (fail closed).
        - name: FORGE_API_TOKEN
          valueFrom: {secretKeyRef: {name: agentdev-api-forge, key: FORGE_API_TOKEN, optional: true}}
        # GitHub (#87): permission checks and approval decisions on GitHub repos. The GitHub App (read-only
        # installation tokens, minted in the API) or a read-only GITHUB_API_TOKEN, both from the optional Secret
        # agentdev-api-github. Without it every GitHub check gives 503 (fail closed); agentdev-admins still works.
        - {name: GITHUB_URL, value: "${GITHUB_URL}"}
        - name: GITHUB_APP_ID
          valueFrom: {secretKeyRef: {name: agentdev-api-github, key: GITHUB_APP_ID, optional: true}}
        - {name: GITHUB_APP_PRIVATE_KEY_FILE, value: /var/run/agentdev/github-app/private-key.pem}
        - name: GITHUB_API_TOKEN
          valueFrom: {secretKeyRef: {name: agentdev-api-github, key: GITHUB_API_TOKEN, optional: true}}
        # security_events table (#70): DATABASE_URL from the Secret 10-api.sh creates (login agentdev_api; schema
        # and retention are set by 10-api.sh as agentdev_owner, the API only inserts, reads and calls the prune function)
        - name: DATABASE_URL
          valueFrom: {secretKeyRef: {name: agentdev-api-db, key: DATABASE_URL}}
        # optional SIEM outputs, instance config only: webhook (#70), syslog over TLS and OTLP (#71); keys in outputs.go
        envFrom: [{secretRef: {name: agentdev-api-siem, optional: true}}]
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        # the App's private key is a file, never an environment variable (same as the forge sidecar, #128)
        volumeMounts: [{name: github-app, mountPath: /var/run/agentdev/github-app, readOnly: true}]
        ports: [{name: http, containerPort: 8080}, {name: internal, containerPort: 8081}]
        readinessProbe: {httpGet: {path: /healthz, port: http}, periodSeconds: 5}
        livenessProbe: {httpGet: {path: /healthz, port: http}, periodSeconds: 20}
        resources:
          requests: {cpu: 20m, memory: 32Mi}
          limits: {memory: 128Mi}
      volumes:
      - name: github-app
        secret:
          secretName: agentdev-api-github
          optional: true
          defaultMode: 0440
          items: [{key: GITHUB_APP_PRIVATE_KEY, path: private-key.pem}]
---
apiVersion: v1
kind: Service
metadata: {name: agentdev-api, namespace: ${PLATFORM_NS}}
spec:
  selector: {app: agentdev-api}
  ports: [{name: http, port: 8080, targetPort: http}]
---
# platform namespace is deny-by-default (platform.yaml.tmpl): the API reaches authentik for OIDC discovery and keys
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: authentik-from-api, namespace: ${PLATFORM_NS}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: authentik, app.kubernetes.io/component: server}}
  policyTypes: [Ingress]
  ingress:
  - from: [{podSelector: {matchLabels: {app: agentdev-api}}}]
    ports: [{port: 9000}]       # http: in-cluster discovery and keys (JWKS is public; TLS inside the cluster: #51)
---
# the API itself: reached through port-forward now; the UI (#48) adds its own rule
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: agentdev-api, namespace: ${PLATFORM_NS}}
spec:
  podSelector: {matchLabels: {app: agentdev-api}}
  policyTypes: [Ingress]
  ingress: []
---
# internal listener (#67): the agents' forge sidecars read approval decisions here; no /api routes, no OIDC
apiVersion: v1
kind: Service
metadata: {name: agentdev-api-internal, namespace: ${PLATFORM_NS}}
spec:
  selector: {app: agentdev-api}
  ports: [{name: internal, port: 8081, targetPort: internal}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: agentdev-api-internal, namespace: ${PLATFORM_NS}}
spec:
  podSelector: {matchLabels: {app: agentdev-api}}
  policyTypes: [Ingress]
  ingress:
  - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}, podSelector: {matchLabels: {app: coding-agent}}}]
    ports: [{port: 8081}]
---
# console chat sessions (#346): the session server in a chat pod accepts only the API. The pod also checks a
# per-session token and refuses requests from its own addresses (images/worker/chat-session-server.js).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: chat-session-server, namespace: ${AGENTS_NS}}
spec:
  podSelector: {matchLabels: {app: agent-chat, agentdev/console: "true"}}
  policyTypes: [Ingress]
  ingress:
  - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${PLATFORM_NS}}}, podSelector: {matchLabels: {app: agentdev-api}}}]
    ports: [{port: 7681}]
---
# The API may create Jobs (#346). This policy holds every Job the API's service account writes to the chat session
# shape, so the Role cannot be used to run another image or to mount another Secret.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-api-chat-jobs}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [batch], apiVersions: ["*"], operations: [CREATE, UPDATE], resources: [jobs]}
  matchConditions:
  - {name: api-only, expression: "request.userInfo.username == 'system:serviceaccount:${PLATFORM_NS}:agentdev-api'"}
  variables:
  - {name: pod, expression: "object.spec.template.spec"}
  - {name: agent, expression: "has(object.metadata.labels) && 'agentdev/chat-agent' in object.metadata.labels ? object.metadata.labels['agentdev/chat-agent'] : ''"}
  - {name: all, expression: "variables.pod.containers + (has(variables.pod.initContainers) ? variables.pod.initContainers : [])"}
  validations:
  - expression: "object.metadata.name.startsWith('chat-') && object.metadata.labels['app'] == 'agent-chat' && object.metadata.labels['agentdev/console'] == 'true' && variables.agent.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')"
    message: "the API creates only console chat Jobs (chat-*, app=agent-chat, agentdev/console=true)"
  - expression: "object.spec.template.metadata.labels['app'] == 'agent-chat' && object.spec.template.metadata.labels['agentdev/console'] == 'true'"
    message: "chat pods keep the labels the egress and ingress policies select"
  - expression: "variables.all.all(c, c.image == '${CHAT_WORKER_IMAGE}')"
    message: "chat Jobs run only the worker image"
  - expression: "variables.pod.runtimeClassName == 'gvisor' && variables.pod.automountServiceAccountToken == false && (!has(variables.pod.serviceAccountName) || variables.pod.serviceAccountName == 'default') && (!has(variables.pod.hostNetwork) || !variables.pod.hostNetwork) && (!has(variables.pod.hostPID) || !variables.pod.hostPID) && (!has(variables.pod.hostIPC) || !variables.pod.hostIPC)"
    message: "chat pods run under gVisor without a service account token or host namespaces"
  - expression: "variables.pod.volumes.all(v, has(v.emptyDir) || (has(v.configMap) && v.configMap.name == 'agentdev-guides'))"
    message: "chat pods mount only emptyDir and the guide ConfigMap"
  - expression: "variables.all.all(c, !has(c.envFrom) && (!has(c.env) || c.env.all(e, !has(e.valueFrom) || (has(e.valueFrom.secretKeyRef) && (e.valueFrom.secretKeyRef.name == 'agent-' + variables.agent + '-proxy' || (c.name == 'clone' && e.valueFrom.secretKeyRef.name == 'agentdev-chat-clone'))))))"
    message: "chat pods read only the agent's proxy key, and the clone step only agentdev-chat-clone"
  - expression: "variables.all.all(c, !has(c.securityContext) || ((!has(c.securityContext.privileged) || !c.securityContext.privileged) && (!has(c.securityContext.allowPrivilegeEscalation) || !c.securityContext.allowPrivilegeEscalation)))"
    message: "no privileged chat containers"
  - expression: "variables.all.all(c, !has(c.securityContext) || !has(c.securityContext.capabilities) || !has(c.securityContext.capabilities.add) || size(c.securityContext.capabilities.add) == 0)"
    message: "chat containers add no capabilities"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-api-chat-jobs}
spec:
  policyName: agentdev-api-chat-jobs
  validationActions: [Deny]
---
# RBAC cannot narrow delete by label: this policy lets the API's service account delete only console chat Jobs
# (not the CLI chat Jobs of scripts/agent-chat.sh or any other Job in ${AGENTS_NS}).
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-api-chat-jobs-delete}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [batch], apiVersions: ["*"], operations: [DELETE], resources: [jobs]}
  matchConditions:
  - {name: api-only, expression: "request.userInfo.username == 'system:serviceaccount:${PLATFORM_NS}:agentdev-api'"}
  validations:
  - expression: "oldObject != null && oldObject.metadata.name.startsWith('chat-') && has(oldObject.metadata.labels) && 'agentdev/console' in oldObject.metadata.labels && oldObject.metadata.labels['agentdev/console'] == 'true' && oldObject.metadata.labels['app'] == 'agent-chat'"
    message: "the API deletes only console chat Jobs"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-api-chat-jobs-delete}
spec:
  policyName: agentdev-api-chat-jobs-delete
  validationActions: [Deny]
