# Webhook router (#3): the cluster's single webhook endpoint. Rendered by 06-agents.sh (envsubst).
# Forges deliver here; the router verifies the signature and wakes the registered agents involved.
# For github.com, expose this Service through an Ingress (one public HTTPS URL for the GitHub App).
apiVersion: v1
kind: Secret
metadata: {name: webhook-router, namespace: ${AGENTS_NS}}
stringData:
  FORGE_SECRETS: "${FORGE_SECRETS}"   # e.g. gitea=<secret> or github=<secret>, comma-separated
  REGISTER_TOKEN: "${REGISTER_TOKEN}"
---
# Scale to zero (#35): the router may read agent StatefulSets and change their replica count, nothing else.
apiVersion: v1
kind: ServiceAccount
metadata: {name: webhook-router, namespace: ${AGENTS_NS}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: webhook-router-scaler, namespace: ${AGENTS_NS}}
rules:
- {apiGroups: [apps], resources: [statefulsets], verbs: [get, list]}
- {apiGroups: [apps], resources: [statefulsets/scale], verbs: [get, patch]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: webhook-router-scaler, namespace: ${AGENTS_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: webhook-router-scaler}
subjects: [{kind: ServiceAccount, name: webhook-router, namespace: ${AGENTS_NS}}]
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: webhook-router, namespace: ${AGENTS_NS}, labels: {app: webhook-router}}
spec:
  replicas: 1
  selector: {matchLabels: {app: webhook-router}}
  template:
    metadata:
      labels: {app: webhook-router}
    spec:
      serviceAccountName: webhook-router
      automountServiceAccountToken: true   # scaling agent StatefulSets (#35), Role above
      securityContext: {runAsUser: 1000, runAsNonRoot: true, fsGroup: 1000}   # fsGroup: reads the poll Secret (0440)
      containers:
      - name: router
        image: ${ROUTER_IMAGE}               # ghcr.io/valentinalexeev/agentdev-router:<tag> (#28)
        imagePullPolicy: ${IMAGE_PULL_POLICY}
        envFrom: [{secretRef: {name: webhook-router}}]
        env:
        - {name: K8S_NAMESPACE, value: "${AGENTS_NS}"}
        # wake poll (#181): starts a stopped agent that has new work on the forge, for instances without webhooks
        - {name: WAKE_POLL_SECONDS, value: "${WAKE_POLL_SECONDS}"}
        - {name: GITEA_URL, value: "${GITEA_URL}"}
        - {name: GITHUB_API_URL, value: "${GITHUB_API_URL}"}
        - {name: FORGE_POLL_DIR, value: /var/run/agentdev/forge-poll}
        volumeMounts: [{name: forge-poll, mountPath: /var/run/agentdev/forge-poll, readOnly: true}]
        ports: [{name: http, containerPort: 8080}]
        readinessProbe: {httpGet: {path: /healthz, port: http}, periodSeconds: 5}
        resources:
          requests: {cpu: 20m, memory: 32Mi}
          limits:   {cpu: 500m, memory: 128Mi}
      volumes:
      # read-only forge credential of the wake poll: gitea-token, or github-app-id, private-key.pem and
      # github-installation-id. Written by 06-agents.sh (kind) or the playbook (GKE); no Secret = no poll credential.
      - {name: forge-poll, secret: {secretName: webhook-router-poll, optional: true, defaultMode: 0440}}
---
apiVersion: v1
kind: Service
metadata: {name: webhook-router, namespace: ${AGENTS_NS}}
spec:
  selector: {app: webhook-router}
  ports: [{name: http, port: 8080, targetPort: http}]
