# Scoped secrets store (#202, ADR 0003 D1): name conventions enforced in the API server (CEL), so that neither a
# compromised operator, API nor anyone with write access in the agents namespace can point an ExternalSecret at
# another store key or overwrite a synced Secret. Rendered by 13-secrets.sh and the playbook.
#   1. ExternalSecret in ${AGENTS_NS}: name ps-<n>, store agentdev-secrets (SecretStore), target ps-<n> owned by ESO,
#      exactly one key "value" from remote key agentdev-ps-<n>. No dataFrom, no find, no templates with data.
#   2. Secret ps-* in ${AGENTS_NS}: only External Secrets Operator writes it.
#   3. SecretStore/ClusterSecretStore: only cluster admins (no agentdev service account may write one).
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-projectsecret-externalsecret}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [external-secrets.io], apiVersions: ["*"], operations: [CREATE, UPDATE], resources: [externalsecrets]}
  variables:
  - {name: "n", expression: "object.metadata.name.startsWith('ps-') ? object.metadata.name.substring(3) : ''"}
  validations:
  - expression: "variables.n != '' && variables.n.matches('^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')"
    message: "ExternalSecret in the agents namespace must be named ps-<ProjectSecret>"
  - expression: "object.spec.secretStoreRef.name == 'agentdev-secrets' && (!has(object.spec.secretStoreRef.kind) || object.spec.secretStoreRef.kind == 'SecretStore')"
    message: "only the SecretStore agentdev-secrets"
  - expression: "has(object.spec.target) && object.spec.target.name == object.metadata.name && object.spec.target.creationPolicy == 'Owner'"
    message: "target must be the Secret of the same name, owned by External Secrets Operator"
  - expression: "!has(object.spec.dataFrom) || size(object.spec.dataFrom) == 0"
    message: "dataFrom is not allowed"
  - expression: "has(object.spec.data) && size(object.spec.data) == 1 && object.spec.data[0].secretKey == 'value' && object.spec.data[0].remoteRef.key == 'agentdev-ps-' + variables.n && !has(object.spec.data[0].remoteRef.property) && !has(object.spec.data[0].sourceRef)"
    message: "exactly one key value from remote key agentdev-ps-<ProjectSecret>"
  - expression: "!has(object.spec.target.template) || ((!has(object.spec.target.template.data) || size(object.spec.target.template.data) == 0) && !has(object.spec.target.template.templateFrom))"
    message: "templates may only set labels and type"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-projectsecret-externalsecret}
spec:
  policyName: agentdev-projectsecret-externalsecret
  validationActions: [Deny]
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-projectsecret-synced}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [""], apiVersions: [v1], operations: [CREATE, UPDATE, DELETE], resources: [secrets]}
  matchConditions:
  - name: ps-prefix
    expression: "(request.operation == 'DELETE' ? oldObject : object).metadata.name.startsWith('ps-')"
  validations:
  - expression: "request.userInfo.username == 'system:serviceaccount:${ESO_NS}:external-secrets' || (request.operation == 'DELETE' && request.userInfo.username in ['system:serviceaccount:kube-system:generic-garbage-collector', 'system:serviceaccount:kube-system:namespace-controller'])"
    message: "Secrets ps-* in the agents namespace are written only by External Secrets Operator (delete the ExternalSecret to remove one)"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-projectsecret-synced}
spec:
  policyName: agentdev-projectsecret-synced
  validationActions: [Deny]
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-secretstores}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
    - {apiGroups: [external-secrets.io], apiVersions: ["*"], operations: [CREATE, UPDATE], resources: [secretstores, clustersecretstores]}
  validations:
  - expression: "!request.userInfo.username.startsWith('system:serviceaccount:${PLATFORM_NS}:') && !request.userInfo.username.startsWith('system:serviceaccount:${AGENTS_NS}:')"
    message: "agentdev service accounts never write secret stores"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-secretstores}
spec:
  policyName: agentdev-secretstores
  validationActions: [Deny]
