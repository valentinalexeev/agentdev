# Scoped secrets store (#202, ADR 0003 D1), GKE: External Secrets Operator reads values from GCP Secret Manager with
# Workload Identity. The Google service account ${SECRETS_GSA} (terraform, infra/terraform/secrets.tf) may only access
# secrets named agentdev-ps-* (IAM condition); the API's account writes them. Rendered by the playbook
# (secrets_backend: gcp).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agentdev-secrets-reader
  namespace: ${AGENTS_NS}
  annotations: {iam.gke.io/gcp-service-account: "${SECRETS_GSA}"}
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata: {name: agentdev-secrets, namespace: ${AGENTS_NS}}
spec:
  provider:
    gcpsm:
      projectID: "${GCP_PROJECT}"
      auth:
        workloadIdentity:
          clusterLocation: "${GKE_LOCATION}"
          clusterName: "${GKE_CLUSTER}"
          clusterProjectID: "${GCP_PROJECT}"
          serviceAccountRef: {name: agentdev-secrets-reader}
---
# No pod runs as agentdev-secrets-reader: External Secrets Operator only requests tokens for it (TokenRequest). A pod
# with this account would hold secretAccessor on every agentdev-ps-* secret through Workload Identity (review of
# #274), and the operator creates pods in this namespace.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-secrets-reader-no-pods}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [""], apiVersions: [v1], operations: [CREATE, UPDATE], resources: [pods]}
    - {apiGroups: [apps], apiVersions: [v1], operations: [CREATE, UPDATE], resources: [deployments, statefulsets, replicasets, daemonsets]}
    - {apiGroups: [batch], apiVersions: [v1], operations: [CREATE, UPDATE], resources: [jobs, cronjobs]}
  variables:
  - name: podSpec
    expression: "object.kind == 'Pod' ? object.spec : (object.kind == 'CronJob' ? object.spec.jobTemplate.spec.template.spec : object.spec.template.spec)"
  validations:
  - expression: "!has(variables.podSpec.serviceAccountName) || variables.podSpec.serviceAccountName != 'agentdev-secrets-reader'"
    message: "no workload may run as agentdev-secrets-reader (it reads every project secret)"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-secrets-reader-no-pods}
spec:
  policyName: agentdev-secrets-reader-no-pods
  validationActions: [Deny]
