# Scoped secrets store (#202, ADR 0003 D1), GKE: External Secrets Operator reads values from GCP Secret Manager with
# Workload Identity. The Google service account ${SECRETS_GSA} (terraform, infra/terraform/secrets.tf) may only access
# secrets named agentdev-ps-* (IAM condition); the API's account writes them. Rendered by the playbook
# (secrets_backend: gcp).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: agentdev-secrets-reader
  namespace: ${AGENTS_NS}
  annotations: {iam.gke.io/gcp-service-account: "${SECRETS_GSA}"}
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata: {name: agentdev-secrets, namespace: ${AGENTS_NS}}
spec:
  provider:
    gcpsm:
      projectID: "${GCP_PROJECT}"
      auth:
        workloadIdentity:
          clusterLocation: "${GKE_LOCATION}"
          clusterName: "${GKE_CLUSTER}"
          clusterProjectID: "${GCP_PROJECT}"
          serviceAccountRef: {name: agentdev-secrets-reader}
