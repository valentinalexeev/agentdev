# One coding agent = one StatefulSet with one replica. Rendered per agent by 06-agents.sh (envsubst).
# Its identity is the two secrets: a forge account token and a Claude credential.
apiVersion: v1
kind: Secret
metadata: {name: agent-${AGENT}, namespace: ${AGENTS_NS}}
stringData:
  FORGE_TOKEN: "${FORGE_TOKEN}"
  WAKE_TOKEN: "${WAKE_TOKEN}"        # router -> this agent
  REGISTER_TOKEN: "${REGISTER_TOKEN}" # this agent -> router (shared by agents of this cluster)
---
# The router forwards wake calls here (#3).
apiVersion: v1
kind: Service
metadata: {name: agent-${AGENT}, namespace: ${AGENTS_NS}}
spec:
  selector: {agent: "${AGENT}"}
  ports: [{name: webhook, port: 8080, targetPort: webhook}]
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: agent-${AGENT}
  namespace: ${AGENTS_NS}
  labels: {app: coding-agent, agent: "${AGENT}"}
spec:
  replicas: 1
  serviceName: agent-${AGENT}
  selector: {matchLabels: {agent: "${AGENT}"}}
  template:
    metadata: {labels: {app: coding-agent, agent: "${AGENT}"}}
    spec:
      runtimeClassName: gvisor
      nodeSelector: {agentdev/pool: sandboxes}
      # GKE: the agent pool is tainted so only agents land there (kind has no taint; the toleration is harmless)
      tolerations:
      - {key: agentdev/pool, operator: Equal, value: sandboxes, effect: NoSchedule}
      - {key: sandbox.gke.io/runtime, operator: Equal, value: gvisor, effect: NoSchedule}
      automountServiceAccountToken: false
      securityContext: {runAsUser: 1000, runAsNonRoot: true, fsGroup: 1000}
      containers:
      - name: agent
        image: ${WORKER_IMAGE}
        imagePullPolicy: ${IMAGE_PULL_POLICY}   # Never on kind (kind load), IfNotPresent with a registry
        env:
        - {name: FORGE_URL,    value: "${FORGE_URL}"}
        - {name: FORGE_USER,   value: "${AGENT}"}
        - {name: REPO,         value: "${REPO}"}
        - {name: POLL_SECONDS, value: "${POLL_SECONDS}"}
        - {name: REVIEWER,     value: "${FORGE_ADMIN_USER}"}
        - {name: ROUTER_URL,   value: "http://webhook-router.${AGENTS_NS}.svc.cluster.local:8080"}
        - {name: SELF_URL,     value: "http://agent-${AGENT}.${AGENTS_NS}.svc.cluster.local:8080/"}
        - {name: FORGE_KIND,   value: "${FORGE_KIND}"}
        - name: WAKE_TOKEN
          valueFrom: {secretKeyRef: {name: agent-${AGENT}, key: WAKE_TOKEN, optional: true}}
        - name: REGISTER_TOKEN
          valueFrom: {secretKeyRef: {name: agent-${AGENT}, key: REGISTER_TOKEN, optional: true}}
        - name: FORGE_TOKEN
          valueFrom: {secretKeyRef: {name: agent-${AGENT}, key: FORGE_TOKEN}}
        # Claude credential: ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`, subscription login).
        # Exactly one secret per agent (#5): its own if it has one, else the shared one. Never both: an
        # ANTHROPIC_API_KEY in the shared secret would override the agent's own OAuth token.
        envFrom:
        - secretRef: {name: ${CLAUDE_SECRET}}
        ports: [{name: webhook, containerPort: 8080}]
        resources:
          requests: {cpu: 200m, memory: 512Mi}
          limits:   {cpu: "2", memory: 2Gi}
        volumeMounts:
        - {name: state,  mountPath: /state}
        - {name: claude, mountPath: /home/node/.claude}
  volumeClaimTemplates:
  - metadata: {name: state}
    spec: {accessModes: [ReadWriteOnce], resources: {requests: {storage: 2Gi}}}
  - metadata: {name: claude}
    spec: {accessModes: [ReadWriteOnce], resources: {requests: {storage: 256Mi}}}
