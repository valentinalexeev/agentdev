# Project secrets (#202), kind store: the API writes the values agentdev-ps-<n> into ${SECRETS_VALUES_NS}. Write-only:
# create, update and delete, no get, list or watch, so the API (and anyone who takes it over) cannot read a value back.
# External Secrets Operator reads them (manifests/secrets-store-kubernetes.yaml.tmpl). Rendered by 13-secrets.sh.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-api-secret-values, namespace: ${SECRETS_VALUES_NS}}
rules:
- {apiGroups: [""], resources: [secrets], verbs: [create, update, delete]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-api-secret-values, namespace: ${SECRETS_VALUES_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-api-secret-values}
subjects: [{kind: ServiceAccount, name: agentdev-api, namespace: ${PLATFORM_NS}}]
