# Platform secrets stores (#381), GKE: one SecretStore ${STORE} in ${NS}, read through Workload Identity as the Google
# service account ${GSA} (infra/terraform/secrets.tf). Its IAM condition names only the secrets of this namespace, so
# the store of the agents namespace can never read a platform-* secret (and the reverse). Rendered by the Ansible
# role external_secrets once per namespace. Separate from the project secrets store agentdev-secrets (#202).
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${STORE}
  namespace: ${NS}
  annotations: {iam.gke.io/gcp-service-account: "${GSA}"}
automountServiceAccountToken: false
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata: {name: ${STORE}, namespace: ${NS}}
spec:
  provider:
    gcpsm:
      projectID: "${GCP_PROJECT}"
      auth:
        workloadIdentity:
          clusterLocation: "${GKE_LOCATION}"
          clusterName: "${GKE_CLUSTER}"
          clusterProjectID: "${GCP_PROJECT}"
          serviceAccountRef: {name: ${STORE}}
