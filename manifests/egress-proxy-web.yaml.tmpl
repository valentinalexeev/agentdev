# kind only (#65): the egress proxy may open 80/443 to any address; Squid's allow-list decides. GKE uses an
# FQDNNetworkPolicy instead (infra/ansible/deploy.yml), which also limits the proxy at the network level.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: egress-proxy-web, namespace: ${AGENTS_NS}}
spec:
  podSelector: {matchLabels: {app: egress-proxy}}
  policyTypes: [Egress]
  egress:
  - ports: [{port: 443, protocol: TCP}, {port: 80, protocol: TCP}]
