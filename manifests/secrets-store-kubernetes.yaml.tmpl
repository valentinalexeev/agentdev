# Scoped secrets store (#202, ADR 0003 D1), kind: External Secrets Operator reads values from Kubernetes Secrets in
# ${SECRETS_VALUES_NS}, a namespace nothing else uses. The API writes agentdev-ps-<name> there (write-only for users);
# ESO syncs each into ps-<name> in ${AGENTS_NS}, next to the credential broker. Rendered by 13-secrets.sh and the
# playbook (secrets_backend: kubernetes). GKE uses manifests/secrets-store-gcp.yaml.tmpl instead.
apiVersion: v1
kind: Namespace
metadata: {name: ${SECRETS_VALUES_NS}, labels: {app.kubernetes.io/part-of: agentdev}}
---
# the store's reader: get on the value Secrets, nothing else (no list: ESO reads by key)
apiVersion: v1
kind: ServiceAccount
metadata: {name: agentdev-secrets-reader, namespace: ${AGENTS_NS}}
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-secrets-reader, namespace: ${SECRETS_VALUES_NS}}
rules:
- {apiGroups: [""], resources: [secrets], verbs: [get]}
- {apiGroups: [authorization.k8s.io], resources: [selfsubjectrulesreviews], verbs: [create]}   # ESO's store check
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-secrets-reader, namespace: ${SECRETS_VALUES_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-secrets-reader}
subjects: [{kind: ServiceAccount, name: agentdev-secrets-reader, namespace: ${AGENTS_NS}}]
---
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata: {name: agentdev-secrets, namespace: ${AGENTS_NS}}
spec:
  provider:
    kubernetes:
      remoteNamespace: ${SECRETS_VALUES_NS}
      server:
        url: https://kubernetes.default.svc
        caProvider: {type: ConfigMap, name: kube-root-ca.crt, key: ca.crt}
      auth:
        serviceAccount: {name: agentdev-secrets-reader}
