# agentdev operator (#47), namespace ${PLATFORM_NS}. Rendered by the role operator. Watches Agent resources in the agents
# namespace only (Role there, not cluster-wide). The CRD itself is images/operator/config/crd (generated).
apiVersion: v1
kind: ServiceAccount
metadata: {name: agentdev-operator, namespace: ${PLATFORM_NS}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-operator, namespace: ${AGENTS_NS}}
rules:   # same rules as the generated images/operator/config/rbac/role.yaml, scoped to one namespace
- {apiGroups: [agentdev.dev], resources: [agents, agents/status], verbs: [get, list, watch, update, patch]}
- {apiGroups: [apps], resources: [statefulsets], verbs: [get, list, watch, create, update, patch, delete]}
- {apiGroups: [""], resources: [services], verbs: [get, list, watch, create, update, patch, delete]}
# workload identity (#352): one service account agent-<name> per agent (no token automount; the pod gets only a
# projected claude-proxy token). No rights to bind roles or to create tokens.
- {apiGroups: [""], resources: [serviceaccounts], verbs: [get, list, watch, create, update, delete]}
# volume layout change (#173): the operator deletes an agent's old claims when it recreates its StatefulSet
- {apiGroups: [""], resources: [persistentvolumeclaims], verbs: [get, delete]}
- {apiGroups: [""], resources: [events], verbs: [create, patch]}
# security events (#70): read agent pod logs, write SecurityEvents, pause an agent, keep log positions
- {apiGroups: [""], resources: [pods], verbs: [get, list, watch]}
# drain before replace (#174): mark an outdated agent pod (agentdev/drain) and delete it once its jobs ended
- {apiGroups: [""], resources: [pods], verbs: [patch, delete]}
- {apiGroups: [""], resources: [pods/log], verbs: [get]}
- {apiGroups: [agentdev.dev], resources: [securityevents], verbs: [get, list, watch, create, delete]}
- {apiGroups: [""], resources: [configmaps], verbs: [create]}   # create cannot be narrowed by name
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-security-positions], verbs: [get, update]}
# approvals (#67, #69): create from the forge sidecar's request line and for executor applies, prune; the decision
# (status) is the API's only
- {apiGroups: [agentdev.dev], resources: [approvals], verbs: [get, list, watch, create, delete]}
# subscription usage limits (#93): state and pauses (written), thresholds set through the API (read only)
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-usage], verbs: [get, update]}
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-usage-settings], verbs: [get]}
# harness guide (#206): one key per agent, written by the operator only; agent pods mount their own key read-only
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-guides], verbs: [get, update]}
# server snapshots (#205, #204): one key per executor, written by the operator only, read by the agents' tools
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-snapshots], verbs: [get, update]}
# drift reports (#205): one key per executor, written by the operator only
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-drift], verbs: [get, update]}
# toolchains (#499): the last good "<key>:<manifest hash>" per agent, read by the init container toolchain at pod start
- {apiGroups: [""], resources: [configmaps], resourceNames: [agentdev-toolchains], verbs: [get, update]}
# scoped secrets store (#202): one ExternalSecret ps-<name> per ProjectSecret (manifests/secrets-policy.yaml.tmpl pins
# its fields); the operator never reads the synced Secrets
- {apiGroups: [agentdev.dev], resources: [projectsecrets], verbs: [get, list, watch]}
- {apiGroups: [agentdev.dev], resources: [projectsecrets/status], verbs: [get, update, patch]}
- {apiGroups: [external-secrets.io], resources: [externalsecrets], verbs: [get, list, watch, create, update, patch, delete]}
# Secrets in the agents namespace (#381, #383, #452): the operator never lists, watches or reads a Secret here, except
# get on the proxy signing key by name (never claude-shared or a forge token). It writes agent-<name>-proxy (#381) and
# agent-<name>-mcp (#383) by server-side apply (create, patch) and deletes agent-<name>-mcp by name; the McpProject
# controller keeps token id, server and renew time in the McpProject status. create, patch and delete cannot be
# narrowed by a name pattern in RBAC: the ValidatingAdmissionPolicy agentdev-operator-secrets (below in this file,
# applied in both secrets modes) limits writes to agent-*-proxy and agent-*-mcp and deletes to agent-*-mcp
# (docs/security.md R52, R119)
- {apiGroups: [""], resources: [secrets], resourceNames: [claude-proxy-signing], verbs: [get]}
# toolchains (#499): the instance's setup proxy credential, copied into agent-<name>-setup-proxy
- {apiGroups: [""], resources: [secrets], resourceNames: [egress-setup-proxy], verbs: [get]}
- {apiGroups: [""], resources: [secrets], verbs: [create, patch, delete]}
# MCP per project (#383, was scripts/mcp-sync.sh): McpProjects
- {apiGroups: [agentdev.dev], resources: [mcpprojects], verbs: [get, list, watch, update, patch]}
- {apiGroups: [agentdev.dev], resources: [mcpprojects/status], verbs: [get, update, patch]}
- {apiGroups: [agentdev.dev], resources: [mcpprojects/finalizers], verbs: [update]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-operator, namespace: ${AGENTS_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-operator}
subjects: [{kind: ServiceAccount, name: agentdev-operator, namespace: ${PLATFORM_NS}}]
---
# #593: why an agent pod stops (Spot preemption, autoscaler scale-down, drain): read the taints of its node. Nodes are
# cluster-scoped, so this is the one ClusterRole of the operator: get only, no list or watch.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata: {name: agentdev-operator-nodes}
rules: [{apiGroups: [""], resources: [nodes], verbs: [get]}]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata: {name: agentdev-operator-nodes}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: agentdev-operator-nodes}
subjects: [{kind: ServiceAccount, name: agentdev-operator, namespace: ${PLATFORM_NS}}]
---
# Proxy keys (#381): the operator writes Secrets in the agents namespace only to keep agent-<name>-proxy (the HMAC of
# the agent name, images/operator/proxykey.go). Its Role allows create and patch on all Secrets there (RBAC cannot
# narrow them by a name pattern); this policy narrows the writes to agent-*-proxy names, and to agent-*-mcp
# for the McpProject controller (#383, also deletes). It sits here, next to the Role,
# so every path that applies the Role (deploy.yml in both secrets modes, the kind operator role) applies the guard too.
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: agentdev-operator-secrets}
spec:
  failurePolicy: Fail
  matchConstraints:
    namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${AGENTS_NS}}}
    resourceRules:
    - {apiGroups: [""], apiVersions: [v1], operations: [CREATE, UPDATE, DELETE], resources: [secrets]}
  matchConditions:
  - name: operator
    expression: "request.userInfo.username == 'system:serviceaccount:${PLATFORM_NS}:agentdev-operator'"
  validations:
  - expression: >-
      request.name.startsWith('agent-') && (request.name.endsWith('-mcp')
      || (request.operation != 'DELETE' && request.name.endsWith('-proxy')))
    message: "the operator writes only agent-<name>-proxy (including agent-<name>-setup-proxy, #499) and agent-<name>-mcp Secrets, and deletes only agent-<name>-mcp, in the agents namespace"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: agentdev-operator-secrets}
spec:
  policyName: agentdev-operator-secrets
  validationActions: [Deny]
---
# MCP per project (#383): the ContextForge admin login, read by name from the Secret ContextForge starts with. Nothing else
# in the platform namespace.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-operator-mcp, namespace: ${PLATFORM_NS}}
rules:
- {apiGroups: [""], resources: [secrets], resourceNames: [contextforge], verbs: [get]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-operator-mcp, namespace: ${PLATFORM_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-operator-mcp}
subjects: [{kind: ServiceAccount, name: agentdev-operator, namespace: ${PLATFORM_NS}}]
---
# deterministic executors (#69): own namespace, so their write credentials never sit next to agents. Only cluster
# admins write Executors and the exec-* Secrets here; agents and the API have no rights in this namespace.
apiVersion: v1
kind: Namespace
metadata: {name: ${EXEC_NS}, labels: {agentdev/role: executors}}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: agentdev-operator, namespace: ${EXEC_NS}}
rules:   # same rules as the generated images/operator/config/rbac/role.yaml (executor.go), scoped to this namespace
- {apiGroups: [agentdev.dev], resources: [executors], verbs: [get, list, watch]}
- {apiGroups: [agentdev.dev], resources: [executors/status], verbs: [get, update, patch]}
# SSH server enrolment (#204): admins write SSHTargets; the operator only reads them and writes their status
- {apiGroups: [agentdev.dev], resources: [sshtargets], verbs: [get, list, watch]}
- {apiGroups: [agentdev.dev], resources: [sshtargets/status], verbs: [get, update, patch]}
- {apiGroups: [agentdev.dev], resources: [executorruns, executorruns/status], verbs: [get, list, watch, create, update, patch, delete]}
- {apiGroups: [batch], resources: [jobs], verbs: [get, list, watch, create, delete]}
- {apiGroups: [""], resources: [persistentvolumeclaims], verbs: [get, list, watch, create, delete]}
- {apiGroups: [""], resources: [pods], verbs: [get, list, watch]}
- {apiGroups: [""], resources: [pods/log], verbs: [get]}
# exec-<name>-forge and the runs' Secrets, by name (no list or watch). Unnamed, so no CA key may live in this namespace:
# step-ca runs in SSH_CA_NS (R133, manifests/step-ca.yaml.tmpl)
- {apiGroups: [""], resources: [secrets], verbs: [get]}
# executor egress (#135): the operator writes the per-executor proxy credentials and Squid rules
- {apiGroups: [""], resources: [secrets], verbs: [create]}   # create cannot be narrowed by name
- {apiGroups: [""], resources: [secrets], resourceNames: [executor-egress-proxy], verbs: [get, update]}
- {apiGroups: [""], resources: [events], verbs: [create, patch]}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: agentdev-operator, namespace: ${EXEC_NS}}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: agentdev-operator}
subjects: [{kind: ServiceAccount, name: agentdev-operator, namespace: ${PLATFORM_NS}}]
---
# executor Jobs take no inbound traffic; outbound: manifests/executor-egress.yaml.tmpl (default deny plus proxy, #135)
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: executors-no-ingress, namespace: ${EXEC_NS}}
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress: []
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: agentdev-operator, namespace: ${PLATFORM_NS}, labels: {app: agentdev-operator}}
spec:
  replicas: 1
  selector: {matchLabels: {app: agentdev-operator}}
  template:
    metadata: {labels: {app: agentdev-operator}}
    spec:
      serviceAccountName: agentdev-operator
      # fsGroup: the probe token (#205) is mounted 0440 for this group
      securityContext: {runAsNonRoot: true, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: operator
        image: ${OPERATOR_IMAGE}
        env:   # cluster-wide agent defaults (kind: kind.vars.yml; GKE: instance.yml)
        - {name: AGENTS_NS, value: "${AGENTS_NS}"}
        - {name: COST_LABELS, value: "${COST_LABELS}"}   # #184: service/environment on agent and executor pods
        - {name: WORKER_IMAGE, value: "${WORKER_IMAGE}"}
        - {name: FORGE_IMAGE, value: "${FORGE_IMAGE}"}
        - {name: IMAGE_PULL_POLICY, value: "${IMAGE_PULL_POLICY}"}
        - {name: FORGE_URL, value: "${FORGE_URL}"}
        - {name: FORGE_PUBLIC_URL, value: "${FORGE_PUBLIC_URL}"}
        - {name: REVIEWER, value: "${FORGE_ADMIN_USER}"}
        - {name: BOTBOARD_URL, value: "${BOTBOARD_URL}"}
        - {name: POLL_SECONDS, value: "${POLL_SECONDS}"}
        - {name: IDLE_SECONDS, value: "${IDLE_SECONDS}"}
        - {name: AGENT_STORAGE_CLASS, value: "${AGENT_STORAGE_CLASS}"}   # #173: the one state volume per agent; empty = cluster default
        - {name: AGENT_STATE_STORAGE, value: "${AGENT_STATE_STORAGE}"}
        - {name: AGENT_EPHEMERAL_REQUEST, value: "${AGENT_EPHEMERAL_REQUEST}"}   # #251: ephemeral-storage of agent pods
        - {name: AGENT_EPHEMERAL_LIMIT, value: "${AGENT_EPHEMERAL_LIMIT}"}
        - {name: FORGE_MIRROR_LIMIT, value: "${FORGE_MIRROR_LIMIT}"}
        - {name: FORGE_EPHEMERAL_LIMIT, value: "${FORGE_EPHEMERAL_LIMIT}"}
        - {name: EGRESS_PROXY, value: "${EGRESS_PROXY}"}   # agents' HTTPS_PROXY (#65); empty = none
        - {name: AGENT_EGRESS_HOSTS, value: "${AGENT_EGRESS_HOSTS}"}   # #206: listed in the harness guide; the proxy enforces its own list
        - {name: CLAUDE_PROXY_URL, value: "${CLAUDE_PROXY_URL}"}   # #66; empty = credential in the agent pod (deprecated)
        - {name: SECURITY_PAUSE_AFTER, value: "${SECURITY_PAUSE_AFTER}"}       # > N events in one job pause the agent
        - {name: SECURITY_RETENTION_DAYS, value: "${SECURITY_RETENTION_DAYS}"} # SecurityEvent objects; the API keeps history
        - {name: SECURITY_MAX_PER_AGENT, value: "${SECURITY_MAX_PER_AGENT}"}
        - {name: SECURITY_RATE_PER_MIN, value: "${SECURITY_RATE_PER_MIN}"}
        - {name: SECURITY_RATE_BURST, value: "${SECURITY_RATE_BURST}"}
        - {name: APPROVALS, value: "${APPROVALS}"}                                # #67, see kind.example.vars.yml
        - {name: APPROVALS_URL, value: "http://agentdev-api-internal.${PLATFORM_NS}.svc.cluster.local:8081"}
        - {name: APPROVAL_TIMEOUT_MINUTES, value: "${APPROVAL_TIMEOUT_MINUTES}"}
        - {name: AGENT_GRACE_SECONDS, value: "${AGENT_GRACE_SECONDS}"}   # #174: time to save work in progress on stop
        - {name: DRAIN_MAX_MINUTES, value: "${DRAIN_MAX_MINUTES}"}       # #174: longest wait for running jobs on upgrade
        - {name: APPROVAL_RETENTION_DAYS, value: "${APPROVAL_RETENTION_DAYS}"}  # Approval objects (#67)
        # deterministic executors (#69); OPERATOR_IMAGE is also the plan hash/verify helper in executor Jobs
        - {name: EXEC_NS, value: "${EXEC_NS}"}
        - {name: SSH_CA_NS, value: "${SSH_CA_NS}"}   # #204 (R133): step-ca and its keys, never in EXEC_NS
        - {name: OPERATOR_IMAGE, value: "${OPERATOR_IMAGE}"}
        - {name: EXECUTOR_POLL_SECONDS, value: "${EXECUTOR_POLL_SECONDS}"}
        - {name: EXECUTOR_RETENTION_DAYS, value: "${EXECUTOR_RETENTION_DAYS}"}
        - {name: EXECUTOR_APPLY_START_MINUTES, value: "${EXECUTOR_APPLY_START_MINUTES}"}
        # executor egress (#135): Jobs go out only through this proxy, to these hosts plus each spec.egressHosts
        - {name: EXECUTOR_EGRESS_PROXY, value: "http://executor-egress-proxy.${EXEC_NS}.svc.cluster.local:3128"}
        - {name: EXECUTOR_EGRESS_HOSTS, value: "${EXECUTOR_EGRESS_HOSTS}"}
        - {name: USAGE_FIVE_HOUR, value: "${USAGE_FIVE_HOUR}"}   # default global usage limits in % (#93); the web UI overrides
        - {name: USAGE_WEEKLY, value: "${USAGE_WEEKLY}"}
        # probe catalogue (#205): server_check of obs-mcp; off without Secret agentdev-probe-token
        - {name: PROBE_LISTEN, value: ":8090"}
        - {name: PROBE_TOKEN_FILE, value: /var/run/agentdev-probe/token}
        - {name: PROBE_RATE_PER_MIN, value: "${PROBE_RATE_PER_MIN}"}
        - {name: PROBE_RATE_BURST, value: "${PROBE_RATE_BURST}"}
        - {name: TELEMETRY_INSTANCE, value: "${TELEMETRY_INSTANCE}"}   # #278: label agentdev_instance on every metric
        - {name: TELEMETRY_OTLP_URL, value: "${TELEMETRY_OTLP_URL}"}   # #196: https OTLP endpoint; empty = Prometheus only
        # external forwarder watch (#213): empty FORWARDER_NS = off. Role in that namespace: roles/ingress (forwarder-watch)
        - {name: FORWARDER_NS, value: "${FORWARDER_NS}"}
        - {name: FORWARDER_SELECTOR, value: "${FORWARDER_SELECTOR}"}   # k=v,k2=v2 (ingress.forwarder.pod_selector)
        - {name: FORWARDER_NOT_READY_MINUTES, value: "${FORWARDER_NOT_READY_MINUTES}"}
        - {name: SECRETS_STORE, value: "${SECRETS_STORE}"}   # #202: SecretStore of ProjectSecrets; empty = off
        - {name: SECRETS_REMOTE_PROPERTY, value: "${SECRETS_REMOTE_PROPERTY}"}   # kind store: value; GCP: empty
        # MCP per project (#383): ContextForge in this namespace, its admin login from Secret contextforge
        - {name: PLATFORM_NS, value: "${PLATFORM_NS}"}
        - {name: MCP_ADMIN_EMAIL, value: "${MCP_ADMIN_EMAIL}"}
        - {name: MCP_ALLOWED_HOSTS, value: "${MCP_ALLOWED_HOSTS}"}   # trusted MCP hosts (host or host:port); others: Ready=False
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        ports: [{name: health, containerPort: 8081}, {name: metrics, containerPort: 9464}, {name: probe, containerPort: 8090}]
        volumeMounts: [{name: probe-token, mountPath: /var/run/agentdev-probe, readOnly: true}]
        readinessProbe: {httpGet: {path: /readyz, port: health}, periodSeconds: 10}
        livenessProbe: {httpGet: {path: /healthz, port: health}, periodSeconds: 20}
        resources:
          requests: {cpu: 20m, memory: 64Mi}
          limits: {memory: 256Mi}
      volumes:
      # shared with obs-mcp only (#205); optional: without it the probe server stays off
      - name: probe-token
        secret: {secretName: agentdev-probe-token, optional: true, defaultMode: 0440}
---
apiVersion: v1
kind: Service
metadata: {name: agentdev-probe, namespace: ${PLATFORM_NS}}
spec:
  selector: {app: agentdev-operator}
  ports: [{name: probe, port: 8090, targetPort: probe}]
---
# inbound only to the probe server (#205) from obs-mcp and to /metrics from the scraper; the agents never reach
# the operator
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: agentdev-operator, namespace: ${PLATFORM_NS}}
spec:
  podSelector: {matchLabels: {app: agentdev-operator}}
  policyTypes: [Ingress]
  ingress:
  - from: [{podSelector: {matchLabels: {app: obs-mcp}}}]
    ports: [{port: 8090}]
  # #196 (ADR 0002 D4): /metrics on 9464 only from the metrics scraper pods (TELEMETRY_SCRAPER_SELECTOR) in its
  # namespace (kind: Prometheus in monitoring, GKE Managed Prometheus: the collector in gmp-system); not from other
  # pods of that namespace (Grafana, the OTLP collector), and never from agent pods
  - from:
    - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: ${TELEMETRY_SCRAPER_NS}}}
      podSelector: {matchLabels: ${TELEMETRY_SCRAPER_SELECTOR}}
    ports: [{port: 9464}]
