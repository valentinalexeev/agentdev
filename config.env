# Pinned versions for the spike. Change here, not in the scripts.
CLUSTER_NAME="${CLUSTER_NAME:-agentdev}"
CONTAINER_ENGINE="${CONTAINER_ENGINE:-docker}"   # docker | podman (podman also needs KIND_EXPERIMENTAL_PROVIDER=podman)

AGENT_SANDBOX_VERSION="${AGENT_SANDBOX_VERSION:-v1.0.8}"
GVISOR_VERSION="${GVISOR_VERSION:-20261012.0}"
CODER_CHART_VERSION="${CODER_CHART_VERSION:-2.38.4}"

SANDBOX_NS="${SANDBOX_NS:-agents}"
CODER_NS="${CODER_NS:-coder}"
AGENT_IMAGE="${AGENT_IMAGE:-agentdev/claude-agent:spike}"

# Coder is reachable on the host at http://localhost:${CODER_HOST_PORT}
CODER_HOST_PORT="${CODER_HOST_PORT:-8080}"
CODER_ADMIN_EMAIL="${CODER_ADMIN_EMAIL:-admin@example.com}"
CODER_ADMIN_USER="${CODER_ADMIN_USER:-admin}"
CODER_ADMIN_PASSWORD="${CODER_ADMIN_PASSWORD:-SpikePassw0rd!}"

KUBECTL="${KUBECTL:-kubectl --context kind-${CLUSTER_NAME}}"   # the GKE playbook (#51) sets its own context

# ---- MVP: coding agents on a forge ----
FORGE_NS="${FORGE_NS:-forge}"
AGENTS_NS="${AGENTS_NS:-coding-agents}"
FORGE_HOST_URL="${FORGE_HOST_URL:-http://localhost:3000}"
FORGE_ADMIN_USER="${FORGE_ADMIN_USER:-owner}"          # you: files issues, reviews PRs
FORGE_ADMIN_PASSWORD="${FORGE_ADMIN_PASSWORD:-SpikePassw0rd!}"
REPO="${REPO:-owner/playground}"
AGENTS="${AGENTS:-alice bob}"              # one forge account + one worker pod each
# Forge of the agents (#2): gitea = the in-cluster Gitea (default); github = a GitHub App registered with
# scripts/github-app.sh (its files in .secrets/github-app/), REPO is then a GitHub owner/name and work is given to an
# agent with the issue label agent:<name>. Webhooks need a public URL (GKE); on kind the agents poll.
FORGE_KIND="${FORGE_KIND:-gitea}"
GITHUB_INSTALLATION_ID="${GITHUB_INSTALLATION_ID:-}"   # optional; looked up from REPO when empty
WORKER_IMAGE="${WORKER_IMAGE:-agentdev/worker:mvp}"
ROUTER_IMAGE="${ROUTER_IMAGE:-agentdev/router:mvp}"   # local builds; published: ghcr.io/valentinalexeev/agentdev-{worker,router}
FORGE_IMAGE="${FORGE_IMAGE:-agentdev/forge:mvp}"      # forge sidecar of every agent pod (#64); published: ghcr.io/valentinalexeev/agentdev-forge
POLL_SECONDS="${POLL_SECONDS:-20}"
MAX_CONCURRENT="${MAX_CONCURRENT:-2}"           # items one agent works on in parallel (#20); 1 = one at a time
SCALE_TO_ZERO="${SCALE_TO_ZERO:-false}"         # true: idle agents are stopped and started again by the router on an event (#35)
IDLE_SECONDS="${IDLE_SECONDS:-900}"              # idle time before an agent asks to be stopped
# Claude credential proxy (#66): the only holder of the Claude credential; agent pods get a per-agent key instead
CLAUDE_PROXY="${CLAUDE_PROXY:-true}"            # false: mount the credential in the agent pod (deprecated rollback, R11 open)
CLAUDE_PROXY_IMAGE="${CLAUDE_PROXY_IMAGE:-agentdev/credproxy:mvp}"   # published: ghcr.io/valentinalexeev/agentdev-credproxy
CLAUDE_BUDGET_TOKENS="${CLAUDE_BUDGET_TOKENS:-0}"   # tokens per agent per 24 h (input, cache and output); 0 = no limit
# security events (#70): more than N events in one run (pod + job) pause the agent
SECURITY_PAUSE_AFTER="${SECURITY_PAUSE_AFTER:-5}"
SECURITY_RATE_PER_MIN="${SECURITY_RATE_PER_MIN:-10}"   # per pod container; over the limit: one rate-limited high event, rest dropped
SECURITY_RATE_BURST="${SECURITY_RATE_BURST:-20}"
# subscription usage limits (#93): default global thresholds in %; an admin changes them in the web UI (Usage page)
USAGE_FIVE_HOUR="${USAGE_FIVE_HOUR:-80}"
USAGE_WEEKLY="${USAGE_WEEKLY:-90}"
# two different retentions: the short-lived working copy in the cluster and the long-term history in Postgres
SECURITY_RETENTION_DAYS="${SECURITY_RETENTION_DAYS:-30}"        # SecurityEvent objects in the cluster (operator env SECURITY_RETENTION_DAYS)
SECURITY_MAX_PER_AGENT="${SECURITY_MAX_PER_AGENT:-500}"         # SecurityEvent objects kept per agent (operator)
SECURITY_DB_RETENTION_DAYS="${SECURITY_DB_RETENTION_DAYS:-365}" # security_events and api_audit (#91) rows in Postgres (stored in the database by 10-api.sh, not an API setting)
BOTBOARD_NS="${BOTBOARD_NS:-botboard}"          # optional agent dashboard (#26, ./run.sh 07)
BOTBOARD_IMAGE="${BOTBOARD_IMAGE:-ghcr.io/valentinalexeev/botboard:sha-ce7d0f9}"   # pinned; botboard has no release tags yet
SERVICE_CIDR="${SERVICE_CIDR:-10.96.0.0/16}"   # cluster Service range (kind default); forge webhooks may reach it
PLATFORM_NS="${PLATFORM_NS:-agentdev-platform}"  # Postgres + ContextForge MCP gateway (#14, ./run.sh 08)
CONTEXTFORGE_IMAGE="${CONTEXTFORGE_IMAGE:-ghcr.io/ibm/mcp-context-forge:v1.1.0}"
POSTGRES_IMAGE="${POSTGRES_IMAGE:-postgres:17.11}"
MCP_ALLOWED_HOSTS="${MCP_ALLOWED_HOSTS:-}"   # trusted MCP server hosts (host or host:port, space separated); mcp-sync refuses others (docs/security.md R46)
CF_ADMIN_EMAIL="${CF_ADMIN_EMAIL:-admin@agentdev.dev}"   # local break-glass admin (no mail is sent; .local is rejected)
AUTHENTIK_VERSION="${AUTHENTIK_VERSION:-2026.8.5}"   # Helm chart = app version (#45, ./run.sh 09)
AUTHENTIK_ADMIN_EMAIL="${AUTHENTIK_ADMIN_EMAIL:-admin@agentdev.dev}"
API_IMAGE="${API_IMAGE:-agentdev-api:dev}"        # management API (#46, ./run.sh 10); ghcr.io/valentinalexeev/agentdev-api:<tag> on GKE
API_OIDC_ISSUER="${API_OIDC_ISSUER:-https://localhost:9443/application/o/agentdev/}"   # as users reach authentik
OPERATOR_IMAGE="${OPERATOR_IMAGE:-agentdev-operator:dev}"   # Agent operator (#47, ./run.sh 12); ghcr.io/valentinalexeev/agentdev-operator:<tag> on GKE
UI_IMAGE="${UI_IMAGE:-agentdev-ui:dev}"           # management UI (#48, ./run.sh 11); ghcr.io/valentinalexeev/agentdev-ui:<tag> on GKE

# ---- Development of this repo (CLAUDE.md, scripts/watch-github.sh) ----
GITHUB_REPO="${GITHUB_REPO:-valentinalexeev/agentdev}"         # repo the AI agent works on
GITHUB_OWNER="${GITHUB_OWNER:-valentinalexeev}"                # decides and approves; only their Approve allows a merge
GITHUB_BOT="${GITHUB_BOT:-valentinalexeev-bot}"                # identity the AI agent acts as
GITHUB_BOT_ENV="${GITHUB_BOT_ENV:-${HOME}/.config/github-bot/env.sh}"   # bot token + git identity, outside the repo
WATCH_POLL_SECONDS="${WATCH_POLL_SECONDS:-60}"
