{# The Secret `authentik` (authentik reads AUTHENTIK_* env), same keys as 09-authentik.sh writes on kind. #}
AUTHENTIK_SECRET_KEY={{ authentik_secret['authentik-secret-key'] }}
AUTHENTIK_POSTGRESQL__HOST=platform-db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD={{ authentik_secret['pg-authentik'] }}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_secret['authentik-admin'] }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_admin_email }}
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS={{ authentik_trusted_proxy_cidrs | join(',') }}
{% if authentik_ui_callback | length > 0 %}
AGENTDEV_UI_CALLBACK={{ authentik_ui_callback }}
{% endif %}
