{# ExternalSecret specs of the platform role (#381), for templates/externalsecrets.j2 (ESO templates from the !unsafe
    dict eso). Same Secret names and keys as manifests/platform.yaml.tmpl and obs-mcp. #}
{% set p = platform_sm_prefix %}
- name: platform-db
  ns: {{ platform_ns }}
  data: {admin: {{ p }}pg-admin, cf: {{ p }}pg-contextforge, agentdev: {{ p }}pg-agentdev, authentik: {{ p }}pg-authentik}
  template:
    POSTGRES_PASSWORD: {{ eso.admin | to_json }}
    init.sql: {{ ("CREATE ROLE contextforge LOGIN PASSWORD '" ~ eso.cf ~ "';\nCREATE DATABASE contextforge OWNER contextforge;\n"
                  ~ "CREATE ROLE agentdev LOGIN PASSWORD '" ~ eso.agentdev ~ "';\nCREATE DATABASE agentdev OWNER agentdev;\n"
                  ~ "CREATE ROLE authentik LOGIN PASSWORD '" ~ eso.authentik ~ "';\nCREATE DATABASE authentik OWNER authentik;\n") | to_json }}
{% if platform_contextforge_enabled | bool %}
- name: contextforge
  ns: {{ platform_ns }}
  data: {cf: {{ p }}pg-contextforge, jwt: {{ p }}jwt, enc: {{ p }}enc, admin: {{ p }}cf-admin, user: {{ p }}cf-default-user, basic: {{ p }}cf-basic-auth}
  template:
    DATABASE_URL: {{ ('postgresql+psycopg://contextforge:' ~ eso.cf ~ '@platform-db:5432/contextforge') | to_json }}
    JWT_SECRET_KEY: {{ eso.jwt | to_json }}
    AUTH_ENCRYPTION_SECRET: {{ eso.enc | to_json }}
    PLATFORM_ADMIN_PASSWORD: {{ ('Aa1!' ~ eso.admin) | to_json }}
    DEFAULT_USER_PASSWORD: {{ ('Aa1!' ~ eso.user) | to_json }}
    BASIC_AUTH_PASSWORD: {{ ('Aa1!' ~ eso.basic) | to_json }}
{% endif %}
{% if platform_obs_mcp_enabled | bool and (obs_mcp.token_secret | default('')) | length > 0 %}
- {name: obs-mcp-token, ns: {{ platform_ns }}, data: {token: {{ obs_mcp.token_secret }}}, template: {token: {{ eso.token | to_json }}}}
{% endif %}
