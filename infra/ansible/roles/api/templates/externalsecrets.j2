{# ExternalSecret specs of the API (#381), for templates/externalsecrets.j2 (ESO templates from the !unsafe dict eso).
    Same Secret names and keys as tasks/secrets_k8s.yml and notify.yml wrote. #}
{% set siem = security.siem | default({}) %}
{% set siem_env = {'SECURITY_WEBHOOK_URL': siem.webhook_url | default(''), 'SECURITY_SYSLOG_ADDR': siem.syslog_addr | default(''),
                    'SECURITY_SYSLOG_SERVER_NAME': siem.syslog_server_name | default(''), 'SECURITY_OTLP_URL': siem.otlp_url | default(''),
                    'SECURITY_OTLP_SERVER_NAME': siem.otlp_server_name | default('')} | dict2items | rejectattr('value', 'equalto', '') | list %}
- name: agentdev-api-db
  ns: {{ platform_ns }}
  data: {pw: {{ api_sm_db_password }}}
  template: {DATABASE_URL: {{ ('postgres://agentdev_api:' ~ eso.pw ~ '@platform-db:5432/agentdev?sslmode=disable') | to_json }}}
- {name: agentdev-api-forge, ns: {{ platform_ns }}, data: {token: {{ api_sm_forge_token }}}, template: {FORGE_API_TOKEN: {{ eso.token | to_json }}}, policy: Delete}
{% if api_github %}
- name: agentdev-api-github
  ns: {{ platform_ns }}
  data: {key: {{ sm_github_app_private_key }}}
  template: {GITHUB_APP_ID: "{{ api_github_app_id | default((github_app | default({})).app_id | default('')) }}", GITHUB_APP_PRIVATE_KEY: {{ eso.key | to_json }}}
{% endif %}
{# instance settings (not secret) first, then the KEY=VALUE lines of the optional Secret Manager entry #}
- name: agentdev-api-siem
  ns: {{ platform_ns }}
  data: {raw: {{ api_sm_siem }}}
  literal: {{ ((siem_env | map(attribute='key') | zip(siem_env | map(attribute='value') | map('to_json')) | map('join', ': ')
               | map('regex_replace', '$', '\n') | join('')) ~ eso.env_lines) | to_json }}
  policy: Delete
{% if api_chat %}
- {name: agentdev-api-chat, ns: {{ platform_ns }}, data: {key: {{ api_sm_chat_key }}}, template: {CHAT_TOKEN_KEY: {{ eso.key | to_json }}}}
{% endif %}
{% if 'webpush' in api_notify_channels %}
- {name: agentdev-api-vapid, ns: {{ platform_ns }}, data: {raw: {{ api_sm_vapid }}}, literal: {{ eso.env_lines | to_json }}}
{% endif %}
