{# ExternalSecrets of the platform (#381), one per item of es_specs:
      {name, ns, data: {key: Secret Manager id}, template: {Secret key: ESO template}, literal: ESO template that
       renders "KEY: value" lines, policy: Retain (default, required values) or Delete (optional values)}
    The specs take their ESO templates from the !unsafe dict eso (group_vars/all.yml), so they
    arrive here as plain strings and stay as written (tests/external_secrets_render.yml).
    Each Secret keeps its name and keys from before (deploy.yml wrote them), so ESO adopts it and no consumer
    changes. Values never pass through Ansible. -#}
{% for s in es_specs %}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ s.name }}
  namespace: {{ s.ns }}
  labels: {app.kubernetes.io/part-of: agentdev, agentdev/secrets: platform}
spec:
  refreshInterval: {{ external_secrets_refresh }}
  secretStoreRef: {name: {{ external_secrets_store }}, kind: SecretStore}
  target:
    name: {{ s.name }}
    creationPolicy: Owner
    deletionPolicy: {{ s.policy | default('Retain') }}
{% if s.template is defined or s.literal is defined %}
    template:
      engineVersion: v2
      mergePolicy: Replace
{% if s.template is defined %}
      data: {{ s.template | to_json }}
{% endif %}
{% if s.literal is defined %}
      templateFrom:
      - target: Data
        literal: {{ s.literal | to_json }}
{% endif %}
{% endif %}
  data:
{% for k, remote in s.data.items() %}
  - {secretKey: {{ k }}, remoteRef: {key: {{ remote | to_json }}, conversionStrategy: Default, decodingStrategy: None}}
{% endfor %}
{% endfor %}
