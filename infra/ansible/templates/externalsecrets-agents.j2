{# ExternalSecret specs of the agents and executors namespaces (#381), for templates/externalsecrets.j2. The ESO
    templates come from the !unsafe dict `eso` (group_vars/all.yml), so they reach the cluster as written.
    Secret names and keys are the ones deploy.yml wrote before; consumers do not change. #}
- {name: claude-shared, ns: {{ agents_ns }}, data: {raw: {{ sm_claude_shared }}}, literal: {{ eso.claude_lines | to_json }}}
{% for a in agents if a.own_claude | default(false) | bool %}
- {name: claude-{{ a.name }}, ns: {{ agents_ns }}, data: {raw: agent-{{ a.name }}-claude}, literal: {{ eso.claude_lines | to_json }}, policy: Delete}
{% endfor %}
- name: webhook-router
  ns: {{ agents_ns }}
  data: {webhook: {{ sm_forge_webhook_secret }}, register: {{ sm_router_register_token }}}
  template: {FORGE_SECRETS: {{ (forge_kind ~ '=' ~ eso.webhook) | to_json }}, REGISTER_TOKEN: {{ eso.register | to_json }}}
{% if (wake_poll_seconds | int) > 0 and forge_kind == 'github' %}
- name: webhook-router-poll
  ns: {{ agents_ns }}
  data: {key: {{ sm_github_app_private_key }}}
  template: {github-app-id: "{{ github_app.app_id }}", private-key.pem: {{ eso.key | to_json }}, github-installation-id: "{{ github_app.installation_id | default('') }}"}
{% elif (wake_poll_seconds | int) > 0 %}
- {name: webhook-router-poll, ns: {{ agents_ns }}, data: {token: {{ sm_router_poll_token }}}, template: {gitea-token: {{ eso.token | to_json }}}, policy: Delete}
{% endif %}
- name: egress-forge-proxy
  ns: {{ agents_ns }}
  data: {password: {{ sm_egress_forge_proxy }}}
  template: {password: {{ eso.password | to_json }}, auth: {{ eso.forge_auth | to_json }}}
- name: egress-setup-proxy
  ns: {{ agents_ns }}
  data: {password: {{ sm_egress_setup_proxy }}}
  template: {password: {{ eso.password | to_json }}, auth: {{ eso.setup_auth | to_json }}}
{% if claude_proxy | bool %}
- {name: claude-proxy-signing, ns: {{ agents_ns }}, data: {key: {{ sm_claude_proxy_signing }}}, template: {key: {{ eso.key | to_json }}}}
{% endif %}
{% for a in agents %}
- name: agent-{{ a.name }}
  ns: {{ agents_ns }}
{% if forge_kind == 'github' %}
  data: {wake: agent-{{ a.name }}-wake-token, register: {{ sm_router_register_token }}, appkey: {{ sm_github_app_private_key }}}
  template: {WAKE_TOKEN: {{ eso.wake | to_json }}, REGISTER_TOKEN: {{ eso.register | to_json }}, GITHUB_APP_ID: "{{ github_app.app_id }}",
             GITHUB_APP_PRIVATE_KEY: {{ eso.appkey | to_json }}, GITHUB_INSTALLATION_ID: "{{ github_app.installation_id | default('') }}"}
{% else %}
  data: {wake: agent-{{ a.name }}-wake-token, register: {{ sm_router_register_token }}, forge: agent-{{ a.name }}-forge-token}
  template: {WAKE_TOKEN: {{ eso.wake | to_json }}, REGISTER_TOKEN: {{ eso.register | to_json }}, FORGE_TOKEN: {{ eso.forge | to_json }}}
{% endif %}
{% endfor %}
{% for e in executors %}
- {name: exec-{{ e.name }}-forge, ns: {{ exec_ns }}, data: {token: exec-{{ e.name }}-forge-token}, template: {FORGE_TOKEN: {{ eso.token | to_json }}}}
- {name: exec-{{ e.name }}-plan, ns: {{ exec_ns }}, data: {raw: exec-{{ e.name }}-plan-env}, literal: {{ eso.env_lines | to_json }}, policy: Delete}
- {name: exec-{{ e.name }}-apply, ns: {{ exec_ns }}, data: {raw: exec-{{ e.name }}-apply-env}, literal: {{ eso.env_lines | to_json }}, policy: Delete}
{% endfor %}
