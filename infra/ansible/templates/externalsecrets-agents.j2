[#- ExternalSecret specs of the agents and executors namespaces (#381), for templates/externalsecrets.j2. Rendered by
    deploy.yml with the delimiters [[ ]] / [% %], so the ESO templates ({{ }}, engine v2, sprig) stay as written.
    Secret names and keys are the ones deploy.yml wrote before; consumers do not change. -#]
[%- set claude_lines = '{{- range $l := splitList "\n" .raw }}{{- $kv := splitn "=" 2 (trim $l) }}{{- if and (has $kv._0 (list "CLAUDE_CODE_OAUTH_TOKEN" "ANTHROPIC_API_KEY")) (ne (trim (default "" $kv._1)) "") }}{{ $kv._0 }}: {{ trim $kv._1 | toJson }}' ~ "\n" ~ '{{ end }}{{- end }}' -%]
[%- set env_lines = '{{- range $l := splitList "\n" .raw }}{{- $kv := splitn "=" 2 (trim $l) }}{{- if and (ne $kv._0 "") (ne (default "" $kv._1) "") }}{{ $kv._0 }}: {{ $kv._1 | toJson }}' ~ "\n" ~ '{{ end }}{{- end }}' -%]
[%- set ns = agents_ns -%]
- {name: claude-shared, ns: [[ ns ]], data: {raw: [[ sm_claude_shared ]]}, literal: [[ claude_lines | to_json ]]}
[%- for a in agents if a.own_claude | default(false) | bool %]
- {name: claude-[[ a.name ]], ns: [[ ns ]], data: {raw: agent-[[ a.name ]]-claude}, literal: [[ claude_lines | to_json ]]}
[%- endfor %]
- name: webhook-router
  ns: [[ ns ]]
  data: {webhook: [[ sm_forge_webhook_secret ]], register: [[ sm_router_register_token ]]}
  template: {FORGE_SECRETS: "[[ forge_kind ]]={{ .webhook }}", REGISTER_TOKEN: "{{ .register }}"}
[%- if (wake_poll_seconds | int) > 0 and forge_kind == 'github' %]
- name: webhook-router-poll
  ns: [[ ns ]]
  data: {key: [[ sm_github_app_private_key ]]}
  template: {github-app-id: "[[ github_app.app_id ]]", private-key.pem: "{{ .key }}", github-installation-id: "[[ github_app.installation_id | default('') ]]"}
[%- elif (wake_poll_seconds | int) > 0 %]
- {name: webhook-router-poll, ns: [[ ns ]], data: {token: [[ sm_router_poll_token ]]}, template: {gitea-token: "{{ .token }}"}, policy: Delete}
[%- endif %]
- name: egress-forge-proxy
  ns: [[ ns ]]
  data: {password: [[ sm_egress_forge_proxy ]]}
  template: {password: "{{ .password }}", auth: '^Basic {{ printf "forge:%s" .password | b64enc }}$'}
[%- if claude_proxy | bool %]
- {name: claude-proxy-signing, ns: [[ ns ]], data: {key: [[ sm_claude_proxy_signing ]]}, template: {key: "{{ .key }}"}}
[%- endif %]
[%- for a in agents %]
- name: agent-[[ a.name ]]
  ns: [[ ns ]]
[%- if forge_kind == 'github' %]
  data: {wake: agent-[[ a.name ]]-wake-token, register: [[ sm_router_register_token ]], appkey: [[ sm_github_app_private_key ]]}
  template: {WAKE_TOKEN: "{{ .wake }}", REGISTER_TOKEN: "{{ .register }}", GITHUB_APP_ID: "[[ github_app.app_id ]]",
             GITHUB_APP_PRIVATE_KEY: "{{ .appkey }}", GITHUB_INSTALLATION_ID: "[[ github_app.installation_id | default('') ]]"}
[%- else %]
  data: {wake: agent-[[ a.name ]]-wake-token, register: [[ sm_router_register_token ]], forge: agent-[[ a.name ]]-forge-token}
  template: {WAKE_TOKEN: "{{ .wake }}", REGISTER_TOKEN: "{{ .register }}", FORGE_TOKEN: "{{ .forge }}"}
[%- endif %]
[%- endfor %]
[%- for e in executors %]
- {name: exec-[[ e.name ]]-forge, ns: [[ exec_ns ]], data: {token: exec-[[ e.name ]]-forge-token}, template: {FORGE_TOKEN: "{{ .token }}"}}
- {name: exec-[[ e.name ]]-plan, ns: [[ exec_ns ]], data: {raw: exec-[[ e.name ]]-plan-env}, literal: [[ env_lines | to_json ]], policy: Delete}
- {name: exec-[[ e.name ]]-apply, ns: [[ exec_ns ]], data: {raw: exec-[[ e.name ]]-apply-env}, literal: [[ env_lines | to_json ]], policy: Delete}
[%- endfor %]
